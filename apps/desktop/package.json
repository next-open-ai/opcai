{
  "name": "@opcai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OPCAI cross-platform local AI workspace.",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @opcai/contracts build && pnpm --filter @opcai/tools build && pnpm --filter @opcai/storage build && pnpm --filter @opcai/agent-core build && pnpm --filter @opcai/api build && pnpm --filter @opcai/renderer build",
    "stage": "node scripts/stage.mjs",
    "package": "pnpm build && pnpm stage && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^24.13.3",
    "electron-builder-squirrel-windows": "^24.13.3",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.opcai.desktop",
    "productName": "OPCAI",
    "directories": { "output": "release" },
    "files": ["src/main/**", "src/preload/**", ".stage/renderer/**"],
    "extraResources": [{ "from": ".stage/api", "to": "api" }],
    "asar": true,
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
