{
  "name": "opcai",
  "version": "0.1.0",
  "private": false,
  "description": "Cross-platform local AI workspace.",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "opcai": "./bin/opcai.mjs"
  },
  "files": [
    "bin",
    "apps/api/dist",
    "apps/renderer/dist",
    "scripts/start-web.mjs",
    "scripts/lib",
    "README.md",
    "README.zh-CN.md",
    "apps/gateway/package.json",
    "apps/gateway/dist",
    "packages/channel/package.json",
    "packages/channel/dist"
  ],
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.1",
    "@lancedb/lancedb": "0.22.3",
    "@larksuiteoapi/node-sdk": "^1.11.1",
    "@opcai/channel": "file:./packages/channel",
    "apache-arrow": "18.1.0",
    "fastify": "^5.3.0",
    "fflate": "^0.8.2",
    "sql.js": "^1.14.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @opcai/desktop dev",
    "web:build": "pnpm build",
    "web:start": "node scripts/start-web.mjs",
    "web:smoke": "node scripts/web-runtime-smoke.mjs",
    "opcai:start": "node bin/opcai.mjs start",
    "opcai:init": "node bin/opcai.mjs init",
    "opcai:doctor": "node bin/opcai.mjs doctor",
    "build": "pnpm --filter @opcai/contracts build && pnpm --filter @opcai/tools build && pnpm --filter @opcai/storage build && pnpm --filter @opcai/channel build && pnpm --filter @opcai/gateway build && pnpm --filter @opcai/agent-core build && pnpm --filter @opcai/orchestrator build && pnpm --filter @opcai/api build && pnpm --filter @opcai/renderer build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "package": "pnpm --filter @opcai/desktop package",
    "size:check": "node scripts/check-size.mjs",
    "orch:smoke": "node scripts/headless-gateway-smoke.mjs",
    "orch:remote-confirm": "node scripts/remote-project-confirm.mjs",
    "orch:remote-chat": "node scripts/remote-chat.mjs",
    "gateway:stub": "node scripts/gateway-stub-smoke.mjs",
    "gateway:config": "node scripts/gateway-config.mjs",
    "gateway:feishu": "node scripts/gateway-feishu-smoke.mjs",
    "gateway:relay": "node scripts/relay-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "ws": "^8.18.0"
  }
}
