{
  "name": "opcai",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform local AI workspace.",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22.0.0" },
  "pnpm": { "onlyBuiltDependencies": ["electron", "esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @opcai/desktop dev",
    "build": "pnpm --filter @opcai/contracts build && pnpm --filter @opcai/tools build && pnpm --filter @opcai/storage build && pnpm --filter @opcai/agent-core build && pnpm --filter @opcai/api build && pnpm --filter @opcai/renderer build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "package": "pnpm --filter @opcai/desktop package",
    "size:check": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
